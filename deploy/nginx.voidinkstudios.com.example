# Sample nginx site for VOIDINK marketing site.
#   voidinkstudios.com / www → static files from the VPS checkout dist/
#
# Install (IONOS VPS, same pattern as Phonicly):
#   sudo cp deploy/nginx.voidinkstudios.com.example /etc/nginx/sites-available/voidinkstudios.com
#   sudo ln -sf /etc/nginx/sites-available/voidinkstudios.com /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d voidinkstudios.com -d www.voidinkstudios.com
#   sudo nginx -t && sudo systemctl reload nginx
#
# After first setup, deploys are:
#   cd /var/www/voidink_frontend/voidinkstudio && ./deploy-web.sh

server {
    listen 80;
    server_name voidinkstudios.com www.voidinkstudios.com;
    return 301 https://voidinkstudios.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.voidinkstudios.com;

    ssl_certificate     /etc/letsencrypt/live/voidinkstudios.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/voidinkstudios.com/privkey.pem;

    return 301 https://voidinkstudios.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name voidinkstudios.com;

    ssl_certificate     /etc/letsencrypt/live/voidinkstudios.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/voidinkstudios.com/privkey.pem;

    root /var/www/voidink_frontend/voidinkstudio/dist;
    index index.html;

    # SPA fallback (React Router) — same idea as Netlify public/_redirects
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Long-cache hashed Vite assets
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
